# Copy this file to .env and fill in your real values.

# PostgreSQL connection. On Railway, provision the Postgres plugin and copy
# its DATABASE_URL here (or set it in Railway -> Variables). Example local:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nomadia"
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nomadia"

# Railway sets PORT automatically. You don't need to set it.
PORT=3001

# JWT signing secret (use a long random string)
JWT_SECRET="replace_with_a_long_random_secret"

# Comma-separated frontend origins allowed by CORS.
# Add your Vercel deployment URL, e.g. https://nomadia-frontend.vercel.app
CORS_ORIGINS="http://localhost:5173,https://nomadia-frontend.vercel.app"

# Google OAuth Web Client ID (used by frontend for "Sign in with Google")
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"